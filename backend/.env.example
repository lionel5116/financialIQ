PORT=4000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=financialiq
PGUSER=postgres
PGPASSWORD=postgres

# Allowed origin(s) for CORS. Comma-separate multiple origins to also allow
# access from another device on your LAN, e.g. an iPad hitting the Mac's IP:
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.1.10:5173
CLIENT_ORIGIN=http://localhost:5173
