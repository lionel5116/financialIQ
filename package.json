{
  "name": "financialiq",
  "version": "1.0.0",
  "private": true,
  "description": "FinancialIQ monorepo — Express/PostgreSQL backend and React/Vite frontend",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "stop": "kill-port 4000 5173 && (pkill -f 'node --watch src/app.js' || true) && (pkill -f 'concurrently -n backend,frontend' || true)"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "kill-port": "^2.0.1"
  }
}
